{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dividend-stock-analysis",
  "main": "src/index.ts",
  // インストール済みの workerd に合わせる。将来日付にすると wrangler が起動を拒否する
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // React アプリ（Vite の出力）。API 以外のパスはここへ流す
  "assets": {
    "directory": "./dist/frontend",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dividend-stock-analysis",
      // ✅ 2026-08-08: `wrangler d1 create dividend-stock-analysis` で採番した実ID
      "database_id": "a46f0e15-f367-4981-aaa0-0679468d3d64",
      "migrations_dir": "db/migrations",
    },
  ],
  "triggers": {
    // EDINET docIDインデックスの日次バッチ（"refresh-edinet-document-index"）。
    // UTC 21:00 = JST 翌06:00（Cron は常に UTC。実装者の提案値。設計書§8-5が未決のため
    // 本番反映後に運用状況を見て調整の余地あり。
    // docs/02_design/logic/edinet-history-import.md §4.4）
    "crons": ["0 21 * * *"],
  },
}
