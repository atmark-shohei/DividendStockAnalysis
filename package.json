{
  "name": "dividend-stock-analysis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "日本株の高配当銘柄を分析・比較し、ウォッチリストとして管理する Web アプリケーション",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "dev:web": "vite",
    "dev:worker": "wrangler dev",
    "build:web": "vite build",
    "build": "npm run build:web && wrangler deploy --dry-run --outdir dist/worker",
    "deploy": "npm run build:web && wrangler deploy",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.frontend.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "hono": "^4.12.32",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@eslint/eslintrc": "^3.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
